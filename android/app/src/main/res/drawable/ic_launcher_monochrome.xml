<?xml version="1.0" encoding="utf-8"?>
<!--
  Capa monocroma del adaptive icon: la que usa Android 13+ para el icono
  temático que se tiñe con los colores del fondo de pantalla. Sin ella, el
  icono se queda a todo color mientras el resto del launcher va teñido, que es
  de las cosas que más delatan que una app no es nativa.

  Es el trazo del logo (assets/logo.svg) portado a vector drawable: el mismo
  grupo con translate(96,96) y scale(13.33) sobre el lienzo de 512.

  OJO: `npm run android:assets` regenera mipmap-anydpi-v26/ic_launcher*.xml y
  borraría la referencia <monochrome>. Si se vuelve a ejecutar, hay que volver a
  añadirla (este drawable no se toca).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:translateX="96"
        android:translateY="96"
        android:scaleX="13.33"
        android:scaleY="13.33">
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M17.596,12.768a2,2 0 1 0 2.829,-2.829l-1.768,-1.767a2,2 0 0 0 2.828,-2.829l-2.828,-2.828a2,2 0 0 0 -2.829,2.828l-1.767,-1.768a2,2 0 1 0 -2.829,2.829z" />
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M2.5,21.5l1.4,-1.4" />
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M20.1,3.9l1.4,-1.4" />
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M5.343,21.485a2,2 0 1 0 2.829,-2.828l1.767,1.768a2,2 0 1 0 2.829,-2.829l-6.364,-6.364a2,2 0 1 0 -2.829,2.829l1.768,1.767a2,2 0 0 0 -2.828,2.829z" />
        <path
