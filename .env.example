VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
# Los medios del catálogo (GIF/WebP) viven en el bucket público `ejercicios`
# de Supabase Storage, no en public/. Ver src/lib/exerciseMediaUrl.ts.

# Solo scripts locales (nunca en el cliente): gyms:import, ejercicios:upload,
# catalogo:medios --upload, catalogo:import --apply
# SUPABASE_SERVICE_ROLE_KEY=

# URI de Postgres (Database Settings). Evita la Management API cuando
# `npx supabase login` es otra cuenta/org y `npm run supabase:types` da 403.
# SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
