VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
# Opcional. Fuerza que TODOS los medios de ejercicios se sirvan desde Supabase
# Storage en web, también los 749 GIF que están en public/ejercicios/. Sin
# definirla, los WebP del catálogo ampliado ya salen de Storage (solo viven
# allí) y los GIF de public/. Ver src/lib/exerciseMediaUrl.ts.
# VITE_EXERCISE_MEDIA_ORIGIN=

# Solo scripts locales (nunca en el cliente): gyms:import, ejercicios:upload,
# catalogo:medios --upload, catalogo:import --apply
# SUPABASE_SERVICE_ROLE_KEY=

# URI de Postgres (Database Settings). Evita la Management API cuando
# `npx supabase login` es otra cuenta/org y `npm run supabase:types` da 403.
# SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
